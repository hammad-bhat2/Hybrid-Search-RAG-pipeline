# ==============================================================
# Hybrid Search RAG Pipeline - Environment Configuration
# ==============================================================

# Application Settings
APP_NAME="Hybrid Search RAG Pipeline"
DEBUG=false

# Vector Database (Qdrant)
# For remote or Docker Qdrant, specify host and port.
# If host is unreachable, the system automatically falls back to local embedded storage.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_STORAGE_PATH="./data/qdrant_db"
COLLECTION_NAME="rag_hybrid_collection"

# Retrieval & Reciprocal Rank Fusion (RRF)
RRF_K=60
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0
DEFAULT_TOP_K=5

# Embedding Models
DENSE_MODEL_NAME="BAAI/bge-small-en-v1.5"
SPARSE_MODEL_NAME="Qdrant/bm25"

# Ingestion Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
UPLOAD_DIR="data/raw"

# LLM Generation Providers
# LLM_PROVIDER can be 'auto', 'openai', 'gemini', or 'fallback'
LLM_PROVIDER=auto

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash"
